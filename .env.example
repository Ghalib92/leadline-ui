# Server-only: signs the httpOnly session cookie. REQUIRED in production.
# Generate one with: openssl rand -base64 32
# SESSION_SECRET=

# Server-only, REQUIRED: the Leadline backend, e.g. http://127.0.0.1:8000/api/v1
# The browser only talks to our server (/api/*), which calls the backend with
# the tokens from the httpOnly cookie.
# On Vercel: https://leadline-api.digitalappex.com/api/v1
API_URL=http://127.0.0.1:8000/api/v1

# Server-only, production: vouches for each visitor's address to the API, for its
# throttles. The same value as UI_PROXY_SECRET in the backend. openssl rand -hex 32
# UI_PROXY_SECRET=

# Application Configuration
VITE_APP_NAME=Leadline
VITE_APP_VERSION=1.0.0


# Optional: Google Analytics
# VITE_GTAG_ID=

# Optional: Sentry Configuration
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=development

# Optional: Feature Flags
# VITE_ENABLE_DEVTOOLS=true

# Optional: SEO — set to "true" on staging/preview to prevent search engine indexing
# VITE_NOINDEX=true
